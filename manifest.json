{
    "manifest_version": 3,
    "name": "智能任务助手",
    "description": "A tool to query resource availability based on task complexity.",
    "version": "1.0",
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "action": {
      "default_popup": "popup/login/login.html", 
      "default_icon": {
        "16": "icons/icon48.png",   
        "48": "icons/icon48.png",   
        "128": "icons/icon128.png"  
      }
    },
    "background": {
      "service_worker": "background.js"  
    },
    "icons": {
      "16": "icons/icon48.png",    
      "48": "icons/icon48.png",    
      "128": "icons/icon128.png"   
    },
    "host_permissions": [
      "https://openrouter.ai/*",
      "http://*/*",
      "https://*/*"
    ],
    "content_security_policy": {

    "extension_pages": "script-src 'self' https://unpkg.com; object-src 'self';"
  }
  }
  